---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <a href="/blog/" class="text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">← Blog</a>
    <header class="mt-8 mb-12">
      <time datetime={post.data.date.toISOString()} class="font-mono text-xs text-zinc-400 dark:text-zinc-500">{formatDate(post.data.date)}</time>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{post.data.title}</h1>
      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {post.data.tags.map((t) => (
              <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 font-mono text-[11px] text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">{t}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose prose-zinc max-w-none dark:prose-invert prose-headings:font-semibold prose-headings:tracking-tight prose-a:underline-offset-4 prose-pre:rounded-xl prose-code:before:content-none prose-code:after:content-none">
      <Content />
    </div>
  </article>
</Base>
