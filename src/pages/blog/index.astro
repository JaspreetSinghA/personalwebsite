---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/posts";
import { profile } from "../../data/profile";

const posts = await getPosts();
---

<Base title={`Blog — ${profile.name}`} description="Notes on embedded systems, race-car electronics, AI evaluation, and things I'm building.">
  <h1 class="text-4xl font-semibold tracking-tight">Blog</h1>
  <p class="mt-3 text-zinc-500 dark:text-zinc-400">Notes on embedded systems, race-car electronics, AI evaluation, and what I'm building.</p>
  <div class="mt-12">
    {posts.length ? <PostList posts={posts} /> : <p class="text-zinc-500">No posts yet.</p>}
  </div>
</Base>
