---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import PostList from "../components/PostList.astro";
import { getPosts, getWriting } from "../lib/posts";
import { profile, experience, projects, education, honors, leadership, skills, about, talks } from "../data/profile";

const recent = (await getWriting()).slice(0, 3);
const published = new Set((await getPosts()).map((p) => p.id));
---

<Base>
  <section class="pb-16">
    <img
      src={profile.photo}
      alt={`Headshot of ${profile.name}`}
      width="96"
      height="96"
      class="mb-8 size-24 rounded-full object-cover ring-1 ring-zinc-200 dark:ring-zinc-800"
    />
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{profile.name}</h1>
    <p class="mt-3 text-lg text-zinc-500 dark:text-zinc-400">{profile.role}</p>
    <p class="mt-8 max-w-xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300">{profile.summary}</p>
    <p class="mt-6 inline-flex items-center gap-2.5 rounded-2xl bg-emerald-50 px-3.5 py-1.5 text-sm text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300">
      <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
      {profile.seeking}
    </p>
    <div class="mt-10 flex flex-wrap gap-3 text-sm">
      <a href={`mailto:${profile.email}`} class="rounded-full bg-zinc-900 px-5 py-2.5 font-medium text-white transition hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300">Get in touch</a>
      <a href={profile.resume} target="_blank" rel="noopener noreferrer" class="rounded-full px-5 py-2.5 font-medium ring-1 ring-zinc-200 transition hover:bg-zinc-50 dark:ring-zinc-800 dark:hover:bg-zinc-900">Resume (PDF)</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="rounded-full px-5 py-2.5 font-medium ring-1 ring-zinc-200 transition hover:bg-zinc-50 dark:ring-zinc-800 dark:hover:bg-zinc-900">GitHub</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-full px-5 py-2.5 font-medium ring-1 ring-zinc-200 transition hover:bg-zinc-50 dark:ring-zinc-800 dark:hover:bg-zinc-900">LinkedIn</a>
    </div>
  </section>

  <Section id="about" title="About">
    <div class="flex max-w-xl flex-col gap-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
      {about.map((para) => <p>{para}</p>)}
    </div>
  </Section>

  <Section id="work" title="Experience">
    <ol class="flex flex-col gap-12">
      {
        experience.map((job) => (
          <li class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-8">
            <p class="pt-0.5 font-mono text-xs text-zinc-400 dark:text-zinc-500">{job.period}</p>
            <div>
              <h3 class="font-medium">
                {job.link ? <a href={job.link} target="_blank" rel="noopener noreferrer" class="hover:underline hover:underline-offset-4">{job.org} ↗</a> : job.org}
                <span class="font-normal text-zinc-400 dark:text-zinc-500"> · {job.orgNote}</span>
              </h3>
              <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{job.role}{job.location && ` · ${job.location}`}</p>
              <ul class="mt-4 flex flex-col gap-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
                {job.points.map((p) => (
                  <li class="relative pl-4 before:absolute before:top-[0.6em] before:left-0 before:size-1 before:rounded-full before:bg-zinc-300 dark:before:bg-zinc-700">{p}</li>
                ))}
              </ul>
              {job.writeup && published.has(job.writeup) && (
                <a href={`/blog/${job.writeup}/`} class="mt-4 inline-block text-sm font-medium hover:underline hover:underline-offset-4">Read the case study →</a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="projects" title="Projects">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((p) => (
          <div class="group relative flex flex-col rounded-2xl p-5 ring-1 ring-zinc-200 transition hover:-translate-y-0.5 hover:ring-zinc-400 dark:ring-zinc-800 dark:hover:ring-zinc-600">
            <h3 class="font-medium">
              <a href={p.href} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between after:absolute after:inset-0 after:rounded-2xl">
                {p.name}
                <span class="text-zinc-400 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
              </a>
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{p.description}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {p.tags.map((t) => (
                <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 font-mono text-[11px] text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">{t}</li>
              ))}
            </ul>
            {((p.writeup && published.has(p.writeup)) || p.links) && (
              <div class="relative z-10 mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {p.writeup && published.has(p.writeup) && (
                  <a href={`/blog/${p.writeup}/`} class="font-medium hover:underline hover:underline-offset-4">Case study →</a>
                )}
                {p.links?.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-900 hover:underline hover:underline-offset-4 dark:text-zinc-400 dark:hover:text-zinc-100">{l.label} ↗</a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="writing" title="Writing">
    <PostList posts={recent} />
    <a href="/blog/" class="mt-6 inline-block text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">All posts →</a>
  </Section>

  <Section id="talks" title="Talks">
    <ul class="flex flex-col gap-6">
      {
        talks.map((t) => (
          <li class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-8">
            <p class="pt-0.5 font-mono text-xs text-zinc-400 dark:text-zinc-500">{t.year}</p>
            <div>
              <h3 class="font-medium">{t.event}</h3>
              <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-300">{t.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="education" title="Education">
    <ul class="flex flex-col gap-8">
      {
        education.map((e) => (
          <li class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-8">
            <p class="pt-0.5 font-mono text-xs text-zinc-400 dark:text-zinc-500">{e.period}</p>
            <div>
              <h3 class="font-medium">{e.school}</h3>
              <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{e.detail}</p>
              <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">{e.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-sm text-zinc-500 dark:text-zinc-400"><span class="font-medium text-zinc-900 dark:text-zinc-100">Honors:</span> {honors.join(" · ")}</p>
  </Section>

  <Section id="leadership" title="Leadership">
    <ul class="flex flex-col gap-8">
      {
        leadership.map((l) => (
          <li class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-8">
            <p class="pt-0.5 font-mono text-xs text-zinc-400 dark:text-zinc-500">{l.period}</p>
            <div>
              <h3 class="font-medium">{l.org}</h3>
              <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{l.role}</p>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">{l.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="skills" title="Skills">
    <dl class="grid gap-6 sm:grid-cols-2">
      {
        Object.entries(skills).map(([group, items]) => (
          <div>
            <dt class="text-sm font-medium">{group}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{items.join(" · ")}</dd>
          </div>
        ))
      }
    </dl>
  </Section>
</Base>
