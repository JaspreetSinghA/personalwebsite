---
import "@fontsource/inter/latin-400.css";
import interRegular from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  /** Path to the social preview image, generated under /og/. */
  image?: string;
  /** Keep the page out of search results (e.g. 404). */
  noindex?: boolean;
  /** Publish date for articles; emitted as article:published_time and in structured data. */
  published?: Date;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.summary,
  type = "website",
  image = "/og/index.png",
  noindex = false,
  published,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// schema.org structured data: Person + WebSite on the homepage, BlogPosting on articles.
const home = new URL("/", Astro.site).href;
const author = { "@type": "Person", "@id": `${home}#person`, name: profile.name, url: home };
const person = {
  ...author,
  image: new URL(profile.photo, Astro.site).href,
  description: profile.summary,
  affiliation: { "@type": "CollegeOrUniversity", name: "San José State University" },
  sameAs: [profile.github, profile.linkedin],
};
const schema =
  noindex ? undefined
  : Astro.url.pathname === "/" ?
    { "@context": "https://schema.org", "@graph": [{ "@type": "WebSite", "@id": `${home}#website`, url: home, name: profile.name, author }, person] }
  : type === "article" && published ?
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: published.toISOString(),
      image: ogImage.href,
      url: canonical.href,
      mainEntityOfPage: canonical.href,
      author,
    }
  : undefined;
// Escape "<" so post text can't close the script tag early.
const schemaJson = schema && JSON.stringify(schema).replace(/</g, "\\u003c");
// Privacy-friendly, cookie-free analytics (GoatCounter); production builds only so local visits aren't counted.
const goatcounter = import.meta.env.PROD ? profile.goatcounter : undefined;
const gcOrigin = goatcounter ? `https://${goatcounter}.goatcounter.com` : "";
// Shiki code blocks use inline style attributes, hence 'unsafe-inline' for styles only.
const csp = [
  "default-src 'self'",
  `script-src 'self'${goatcounter ? " https://gc.zgo.at" : ""}`,
  "style-src 'self' 'unsafe-inline'",
  `img-src 'self' data: ${gcOrigin}`.trim(),
  `connect-src 'self' ${gcOrigin}`.trim(),
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join("; ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === "article" && <meta property="article:author" content={profile.name} />}
    {schemaJson && <script is:inline type="application/ld+json" set:html={schemaJson} />}
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {goatcounter && <script is:inline async data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body class="min-h-screen font-sans">
    <div class="mx-auto flex min-h-screen max-w-3xl flex-col px-6">
      <Header />
      <main class="flex-1 py-16 sm:py-24">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
