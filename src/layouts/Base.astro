---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  /** Path to the social preview image, generated under /og/. */
  image?: string;
  /** Keep the page out of search results (e.g. 404). */
  noindex?: boolean;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.summary,
  type = "website",
  image = "/og/index.png",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Privacy-friendly, cookie-free analytics (GoatCounter); production builds only so local visits aren't counted.
const goatcounter = import.meta.env.PROD ? profile.goatcounter : undefined;
const gcOrigin = goatcounter ? `https://${goatcounter}.goatcounter.com` : "";
// Shiki code blocks use inline style attributes, hence 'unsafe-inline' for styles only.
const csp = [
  "default-src 'self'",
  `script-src 'self'${goatcounter ? " https://gc.zgo.at" : ""}`,
  "style-src 'self' 'unsafe-inline'",
  `img-src 'self' data: ${gcOrigin}`.trim(),
  `connect-src 'self' ${gcOrigin}`.trim(),
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join("; ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {goatcounter && <script is:inline async data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body class="min-h-screen font-sans">
    <div class="mx-auto flex min-h-screen max-w-3xl flex-col px-6">
      <Header />
      <main class="flex-1 py-16 sm:py-24">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
