---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/posts";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props;
---

<ul class="-mx-3 flex flex-col">
  {
    posts.map((post) => (
      <li>
        <a
          href={`/blog/${post.id}/`}
          class="group flex flex-col gap-1 rounded-lg px-3 py-3 transition-colors hover:bg-zinc-50 sm:flex-row sm:items-baseline sm:gap-6 dark:hover:bg-zinc-900"
        >
          <time datetime={post.data.date.toISOString()} class="shrink-0 font-mono text-xs text-zinc-400 tabular-nums sm:w-28 dark:text-zinc-500">
            {formatDate(post.data.date)}
          </time>
          <span class="font-medium group-hover:underline group-hover:underline-offset-4">{post.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>
