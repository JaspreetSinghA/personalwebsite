---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="scroll-mt-24 border-t border-zinc-100 py-14 dark:border-zinc-900">
  <h2 class="mb-8 font-mono text-xs font-medium tracking-widest text-zinc-500 uppercase dark:text-zinc-400">{title}</h2>
  <slot />
</section>
