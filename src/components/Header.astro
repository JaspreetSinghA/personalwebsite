---
import { profile } from "../data/profile";

const links = [
  { href: "/#work", label: "Work" },
  { href: "/#projects", label: "Projects" },
  { href: "/blog/", label: "Blog" },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-10 -mx-6 border-b border-zinc-100 bg-white/80 px-6 backdrop-blur dark:border-zinc-900 dark:bg-zinc-950/80">
  <nav class="flex h-16 items-center justify-between text-sm">
    <a href="/" class="font-medium tracking-tight">{profile.name}</a>
    <ul class="flex items-center gap-6 text-zinc-500 dark:text-zinc-400">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                "transition-colors hover:text-zinc-900 dark:hover:text-zinc-100",
                href === "/blog/" && path.startsWith("/blog") && "text-zinc-900 dark:text-zinc-100",
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
