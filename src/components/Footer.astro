---
import { profile } from "../data/profile";
const year = new Date().getFullYear();
---

<footer class="flex flex-col gap-4 border-t border-zinc-100 py-10 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between dark:border-zinc-900 dark:text-zinc-400">
  <p>© {year} {profile.name}</p>
  <ul class="flex gap-6">
    <li><a class="hover:text-zinc-900 dark:hover:text-zinc-100" href={profile.github} rel="me noopener" target="_blank">GitHub</a></li>
    <li><a class="hover:text-zinc-900 dark:hover:text-zinc-100" href={profile.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
    <li><a class="hover:text-zinc-900 dark:hover:text-zinc-100" href={`mailto:${profile.email}`}>Email</a></li>
    <li><a class="hover:text-zinc-900 dark:hover:text-zinc-100" href="/rss.xml">RSS</a></li>
  </ul>
</footer>
